{
  "name": "meerkats-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:local": "node --env-file=.env --import tsx scripts/local-db.ts"
  },
  "dependencies": {
    "fastify": "5.12.5", "drizzle-orm": "0.45.3", "pg": "8.23.0", "zod": "4.6.5"
  },
  "overrides": { "@esbuild-kit/core-utils": { "esbuild": "0.28.2" } },
  "devDependencies": {
    "@types/node": "24.13.2", "@types/pg": "8.23.1", "typescript": "6.0.2",
    "tsx": "4.23.15", "drizzle-kit": "0.31.11", "vitest": "5.0.1",
    "eslint": "10.5.0", "@eslint/js": "10.0.1", "typescript-eslint": "8.61.0",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
