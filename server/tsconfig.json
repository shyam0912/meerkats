{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "rootDir": "..", "outDir": "dist", "types": ["node"]
  },
  "include": ["src", "scripts", "tests", "../contracts", "drizzle.config.ts", "vitest.config.ts"]
}
